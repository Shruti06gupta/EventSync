{
  "name": "eventsync",
  "version": "1.0.0",
  "private": true,
  "description": "EventSync — event discovery platform",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "seed:events": "npm run seed:events --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
