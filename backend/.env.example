PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string
CLIENT_URL=http://localhost:5173

# JWT Secrets - IMPORTANT SECURITY NOTES:
# - These secrets are used to sign and verify JWT tokens
# - ROTATE these secrets immediately after any security incident
# - After rotation, all users must log in again (all existing tokens become invalid)
# - Generate new secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - NEVER commit actual secret values to version control
# - Keep access and refresh secrets different
JWT_ACCESS_SECRET=generate_with_node_-e_console.log_require_crypto_randomBytes_32_toString_hex
JWT_REFRESH_SECRET=generate_with_node_-e_console.log_require_crypto_randomBytes_32_toString_hex

EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=your_email@gmail.com
# Email delivery:
# - development: set true unless you are testing SMTP
# - staging: set true unless you are verifying real mail delivery
# - production: set false so password-reset and deadline reminder emails are sent
EMAIL_DRY_RUN=false

# Set true for local/E2E verification to prevent Unstop/Devfolio sync and reminder emails
DISABLE_SCHEDULER=false

ADMIN_CODE=your-secret-admin-code
GEMINI_API_KEY=your_gemini_api_key